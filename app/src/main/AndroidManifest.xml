<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Used to search for a city or village by name, and by the phone's place naming service to
        name the phone's position. The times are worked out on the phone. Nothing about the
        user's reading or their tasbih is ever sent.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Asked for only when the user chooses to use the phone's position for prayer times. The
        user picks precise or approximate in the system's dialog: approximate is enough for the
        times and the town's name, and precise also names the district.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Prayer alerts, each asked for or explained when the user turns alerts on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Granted by the user in the system's alarms screen. Not USE_EXACT_ALARM, which Google Play
        keeps for alarm clock and calendar apps. Without it alerts may come up to ten minutes late.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- A restart clears every alarm, so the next prayer's alert is set again after it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The full adhan plays from a foreground service that the prayer's exact alarm starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Neither is required: a place can be searched for, and the Qibla shown as a bearing. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:name=".SakinahApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sakinah"
        tools:targetApi="33">
        <!-- Empty in a build without maps.properties, where the satellite view is not offered. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
        <!-- Google's map renderer still loads Apache HTTP classes, which Android 9 and later
             leave out unless the app asks for them. Without this the satellite view crashes. -->
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            A widget's «customise»: Android opens it from a long press on the widget, and before
            Android 12 when one is placed from the launcher's list. It hands over to the app at once.
        -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Calendar widgets. They need no permission; their «customise» opens the calendar's settings. -->
        <receiver
            android:name=".widget.CalendarDateWidget"
            android:exported="true"
            android:label="@string/cal_date_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_calendar_date_widget" />
        </receiver>

        <receiver
            android:name=".widget.CalendarMonthWidget"
            android:exported="true"
            android:label="@string/cal_month_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_calendar_month_widget" />
        </receiver>

        <receiver
            android:name=".widget.CalendarOccasionWidget"
            android:exported="true"
            android:label="@string/cal_occasion_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_calendar_occasion_widget" />
        </receiver>

        <!--
            Turns the calendar widgets' day: their own midnight alarm, or the clock or time zone
            changing. None of these broadcasts needs a permission.
        -->
        <receiver
            android:name=".widget.CalendarRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Prayer widgets: the next prayer, the day's five, and the Qibla. -->
        <receiver
            android:name=".widget.PrayerNextWidget"
            android:exported="true"
            android:label="@string/prayer_next_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_prayer_next_widget" />
        </receiver>

        <receiver
            android:name=".widget.PrayerDayWidget"
            android:exported="true"
            android:label="@string/prayer_day_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_prayer_day_widget" />
        </receiver>

        <receiver
            android:name=".widget.PrayerQiblaWidget"
            android:exported="true"
            android:label="@string/prayer_qibla_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_qibla_widget" />
        </receiver>

        <!-- Prayer alarms ringing, and everything that clears or moves them. -->
        <receiver
            android:name=".alerts.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Today's wird on the home screen, each task ticked done from the widget itself. -->
        <receiver
            android:name=".wird.WirdWidget"
            android:exported="true"
            android:label="@string/wird_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anaa_wird_widget" />
        </receiver>

        <!-- The wird's reminders ringing, their buttons, the widget's ticks, and what moves alarms. -->
        <receiver
            android:name=".wird.WirdReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Plays the full adhan the user chose for a prayer, with a stop button in its notification. -->
        <service
            android:name=".alerts.AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
