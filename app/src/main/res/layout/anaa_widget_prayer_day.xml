<?xml version="1.0" encoding="utf-8"?>
<!--
    The day's five prayers side by side, the next one's time marked, under up to three lines the
    user composes. Fixed views, no list, so nothing scrolls. The paper and marks are pictures
    tinted from code, and the pattern is drawn from code, so every colour and its strength can be
    chosen and still work before Android 12.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/pd_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/anaa_widget_paper" />

    <!-- A pattern of eight-pointed stars over the paper, drawn from code at the widget's size. -->
    <ImageView
        android:id="@+id/pd_pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pd_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!--
            Room the widget has beyond what it shows is shared out evenly: above the lines, on
            each side of the ruled star between them and the prayers, and below the prayers.
            Until November 27, 2026 it all went to the prayers, which floated in a wide gap.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/pd_line_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l0_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l0_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l0_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l0_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pd_line_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l1_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l1_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l1_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l1_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pd_line_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l2_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l2_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l2_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l2_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <!--
            The gap between the lines and the prayers: a share of the room above the ruled star
            and a share below it, or one share alone where there is no star, none without lines.
        -->
        <FrameLayout
            android:id="@+id/pd_gap_above"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- A ruled line with an eight-pointed star between the lines and the prayers. -->
        <ImageView
            android:id="@+id/pd_divider"
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/anaa_widget_divider"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/pd_gap_below"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!--
            The prayers, in one box when the user wants them so: its fill and its line, each a
            solid picture tinted from code with its own strength, under the row.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/pd_box_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/anaa_widget_cell_fill"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/pd_box_line"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/anaa_widget_cell_line"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/pd_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/pd_cell_0"
                    style="@style/AnaaWidgetPrayerCell"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_0" style="@style/AnaaWidgetPrayerName" />

                    <!--
                        The next prayer is marked round its time alone. A RelativeLayout ties the mark
                        to the time's edges; a FrameLayout would leave a lone stretched child at nothing.
                    -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false">

                        <!-- Wider than the time by a margin outside it, so the time keeps all its width. -->
                        <ImageView
                            android:id="@+id/pd_mark_0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:layout_marginRight="-5dp"
                            android:layout_alignBottom="@+id/pd_time_0"
                            android:layout_alignLeft="@+id/pd_time_0"
                            android:layout_alignRight="@+id/pd_time_0"
                            android:layout_alignTop="@+id/pd_time_0"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/anaa_widget_mark_filled"
                            android:visibility="invisible" />

                        <TextView android:id="@+id/pd_time_0" style="@style/AnaaWidgetPrayerTime" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pd_cell_1"
                    style="@style/AnaaWidgetPrayerCell"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_1" style="@style/AnaaWidgetPrayerName" />

                    <!--
                        The next prayer is marked round its time alone. A RelativeLayout ties the mark
                        to the time's edges; a FrameLayout would leave a lone stretched child at nothing.
                    -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false">

                        <!-- Wider than the time by a margin outside it, so the time keeps all its width. -->
                        <ImageView
                            android:id="@+id/pd_mark_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:layout_marginRight="-5dp"
                            android:layout_alignBottom="@+id/pd_time_1"
                            android:layout_alignLeft="@+id/pd_time_1"
                            android:layout_alignRight="@+id/pd_time_1"
                            android:layout_alignTop="@+id/pd_time_1"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/anaa_widget_mark_filled"
                            android:visibility="invisible" />

                        <TextView android:id="@+id/pd_time_1" style="@style/AnaaWidgetPrayerTime" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pd_cell_2"
                    style="@style/AnaaWidgetPrayerCell"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_2" style="@style/AnaaWidgetPrayerName" />

                    <!--
                        The next prayer is marked round its time alone. A RelativeLayout ties the mark
                        to the time's edges; a FrameLayout would leave a lone stretched child at nothing.
                    -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false">

                        <!-- Wider than the time by a margin outside it, so the time keeps all its width. -->
                        <ImageView
                            android:id="@+id/pd_mark_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:layout_marginRight="-5dp"
                            android:layout_alignBottom="@+id/pd_time_2"
                            android:layout_alignLeft="@+id/pd_time_2"
                            android:layout_alignRight="@+id/pd_time_2"
                            android:layout_alignTop="@+id/pd_time_2"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/anaa_widget_mark_filled"
                            android:visibility="invisible" />

                        <TextView android:id="@+id/pd_time_2" style="@style/AnaaWidgetPrayerTime" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pd_cell_3"
                    style="@style/AnaaWidgetPrayerCell"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_3" style="@style/AnaaWidgetPrayerName" />

                    <!--
                        The next prayer is marked round its time alone. A RelativeLayout ties the mark
                        to the time's edges; a FrameLayout would leave a lone stretched child at nothing.
                    -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false">

                        <!-- Wider than the time by a margin outside it, so the time keeps all its width. -->
                        <ImageView
                            android:id="@+id/pd_mark_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:layout_marginRight="-5dp"
                            android:layout_alignBottom="@+id/pd_time_3"
                            android:layout_alignLeft="@+id/pd_time_3"
                            android:layout_alignRight="@+id/pd_time_3"
                            android:layout_alignTop="@+id/pd_time_3"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/anaa_widget_mark_filled"
                            android:visibility="invisible" />

                        <TextView android:id="@+id/pd_time_3" style="@style/AnaaWidgetPrayerTime" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pd_cell_4"
                    style="@style/AnaaWidgetPrayerCell"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_4" style="@style/AnaaWidgetPrayerName" />

                    <!--
                        The next prayer is marked round its time alone. A RelativeLayout ties the mark
                        to the time's edges; a FrameLayout would leave a lone stretched child at nothing.
                    -->
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clipChildren="false">

                        <!-- Wider than the time by a margin outside it, so the time keeps all its width. -->
                        <ImageView
                            android:id="@+id/pd_mark_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-5dp"
                            android:layout_marginRight="-5dp"
                            android:layout_alignBottom="@+id/pd_time_4"
                            android:layout_alignLeft="@+id/pd_time_4"
                            android:layout_alignRight="@+id/pd_time_4"
                            android:layout_alignTop="@+id/pd_time_4"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/anaa_widget_mark_filled"
                            android:visibility="invisible" />

                        <TextView android:id="@+id/pd_time_4" style="@style/AnaaWidgetPrayerTime" />
                    </RelativeLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- How much of the time between the last prayer and the next has passed, filling from the right. -->
        <ProgressBar
            android:id="@+id/pd_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="1000"
            android:mirrorForRtl="false"
            android:progressDrawable="@drawable/anaa_widget_progress"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
