<?xml version="1.0" encoding="utf-8"?>
<!--
    The day's five prayers side by side, the next one marked, under up to three lines the user
    composes. Fixed views, no list, so nothing scrolls. The paper, frame and marks are pictures
    tinted from code, so every colour and its strength can be chosen and still work before Android 12.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/pd_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/anaa_widget_paper" />

    <ImageView
        android:id="@+id/pd_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/anaa_widget_frame"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pd_corner_0"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="top|start"
        android:layout_margin="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/anaa_widget_khatam"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pd_corner_1"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="top|end"
        android:layout_margin="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/anaa_widget_khatam"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pd_corner_2"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/anaa_widget_khatam"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/pd_corner_3"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/anaa_widget_khatam"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/pd_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/pd_line_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l0_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l0_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l0_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l0_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pd_line_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l1_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l1_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l1_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l1_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pd_line_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/pd_l2_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l2_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pd_l2_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/pd_l2_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <!-- A ruled line with an eight-pointed star between the lines and the prayers. -->
        <ImageView
            android:id="@+id/pd_divider"
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/anaa_widget_divider"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/pd_cell_0" style="@style/AnaaWidgetPrayerCell">

                <ImageView
                    android:id="@+id/pd_mark_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/anaa_widget_mark_filled"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_0" style="@style/AnaaWidgetPrayerName" />
                    <TextView android:id="@+id/pd_time_0" style="@style/AnaaWidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/pd_cell_1" style="@style/AnaaWidgetPrayerCell">

                <ImageView
                    android:id="@+id/pd_mark_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/anaa_widget_mark_filled"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_1" style="@style/AnaaWidgetPrayerName" />
                    <TextView android:id="@+id/pd_time_1" style="@style/AnaaWidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/pd_cell_2" style="@style/AnaaWidgetPrayerCell">

                <ImageView
                    android:id="@+id/pd_mark_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/anaa_widget_mark_filled"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_2" style="@style/AnaaWidgetPrayerName" />
                    <TextView android:id="@+id/pd_time_2" style="@style/AnaaWidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/pd_cell_3" style="@style/AnaaWidgetPrayerCell">

                <ImageView
                    android:id="@+id/pd_mark_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/anaa_widget_mark_filled"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_3" style="@style/AnaaWidgetPrayerName" />
                    <TextView android:id="@+id/pd_time_3" style="@style/AnaaWidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/pd_cell_4" style="@style/AnaaWidgetPrayerCell">

                <ImageView
                    android:id="@+id/pd_mark_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/anaa_widget_mark_filled"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView android:id="@+id/pd_name_4" style="@style/AnaaWidgetPrayerName" />
                    <TextView android:id="@+id/pd_time_4" style="@style/AnaaWidgetPrayerTime" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- How much of the time between the last prayer and the next has passed, filling from the right. -->
        <ProgressBar
            android:id="@+id/pd_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="1000"
            android:mirrorForRtl="false"
            android:progressDrawable="@drawable/anaa_widget_progress"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
