<?xml version="1.0" encoding="utf-8"?>
<!--
    The Qibla widget: one cell, like an app icon, with the Kaaba and the bearing beneath it. It
    shows a fixed number and opens the compass when touched, so nothing on it moves.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/anaa_widget_background"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/qb_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/anaa_widget_kaaba" />

        <TextView
            android:id="@+id/qb_bearing"
            style="@style/AnaaWidgetLine"
            android:layout_weight="0.9"
            android:autoSizeMaxTextSize="18sp"
            android:text="@string/qibla_title"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
