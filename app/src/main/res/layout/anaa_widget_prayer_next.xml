<?xml version="1.0" encoding="utf-8"?>
<!--
    The next prayer: its name, its time, up to two lines the user composes, and a bar of the time
    passed since the last prayer. Fixed views, nothing scrolls; the paper is a tinted picture and the
    pattern is drawn from code, as in the day's widget.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/nx_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/anaa_widget_paper" />

    <!-- A pattern of eight-pointed stars over the paper, drawn from code at the widget's size. -->
    <ImageView
        android:id="@+id/nx_pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/nx_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/nx_name"
            style="@style/AnaaWidgetLine"
            android:layout_weight="0.8"
            android:autoSizeMaxTextSize="16sp"
            android:textColor="@color/anaa_widget_accent" />

        <TextView
            android:id="@+id/nx_time"
            style="@style/AnaaWidgetLine"
            android:layout_weight="1.3"
            android:autoSizeMaxTextSize="30sp" />

        <ImageView
            android:id="@+id/nx_divider"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/anaa_widget_divider"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nx_line_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/nx_l0_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/nx_l0_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nx_l0_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/nx_l0_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nx_line_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/nx_l1_r"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/nx_l1_rc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nx_l1_l"
                style="@style/AnaaWidgetInfoLine" />

            <Chronometer
                android:id="@+id/nx_l1_lc"
                style="@style/AnaaWidgetInfoLine"
                android:visibility="gone" />
        </LinearLayout>

        <!-- How much of the time between the last prayer and the next has passed, filling from the right. -->
        <ProgressBar
            android:id="@+id/nx_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="1000"
            android:mirrorForRtl="false"
            android:progressDrawable="@drawable/anaa_widget_progress"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
