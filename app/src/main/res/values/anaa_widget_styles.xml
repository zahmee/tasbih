<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar widgets. The month grid's text sizes are set from code to fit the widget's size. -->
<resources>
    <style name="AnaaWidgetLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/anaa_widget_text</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
    </style>

    <style name="AnaaWidgetWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/anaa_widget_text_soft</item>
    </style>

    <style name="AnaaWidgetCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="AnaaWidgetDay">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/anaa_widget_text</item>
    </style>

    <style name="AnaaWidgetOtherDay" parent="AnaaWidgetDay">
        <item name="android:textColor">@color/anaa_widget_text_soft</item>
    </style>

    <!-- The phone's events under a day, as the dots in the app: one per colour. -->
    <style name="AnaaWidgetDots" parent="AnaaWidgetDay">
        <item name="android:textSize">7sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="AnaaWidgetChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/anaa_widget_text</item>
    </style>
    <style name="AnaaWidgetPrayerCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <!-- One side of a line above the prayers. -->
    <style name="AnaaWidgetInfoLine">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/anaa_widget_text</item>
    </style>

    <style name="AnaaWidgetPrayerName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/anaa_widget_text_soft</item>
    </style>

    <!-- As wide as its words, so the next prayer's mark is round the time alone. -->
    <style name="AnaaWidgetPrayerTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/anaa_widget_text</item>
    </style>
</resources>
