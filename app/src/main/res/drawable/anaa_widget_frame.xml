<?xml version="1.0" encoding="utf-8"?>
<!-- A thin frame inside the paper's edge, its corners left to the stars. Tinted from code. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="11dp">
    <shape android:shape="rectangle">
        <solid android:color="#00000000" />
        <stroke android:width="1dp" android:color="#FFFFFFFF" />
        <corners android:radius="12dp" />
    </shape>
</inset>
